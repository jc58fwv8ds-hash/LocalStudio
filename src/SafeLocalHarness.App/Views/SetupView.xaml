<UserControl x:Class="SafeLocalHarness.App.Views.SetupView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="54,48,54,70" MaxWidth="920">
            <TextBlock Text="LocalStudioを準備" Style="{StaticResource TitleText}"/>
            <TextBlock Text="必要なローカルAIを、管理者権限を使わずに準備します。ボタンを押すまで、ダウンロードや通信は行いません。" FontSize="17" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,32"/>

            <Border Style="{StaticResource Card}" Padding="32">
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{Binding Status}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,24,0"/></StackPanel>
                        <Border Grid.Column="1" Background="#E8F3FF" CornerRadius="17" Padding="14,7" VerticalAlignment="Top"><TextBlock Text="ユーザー領域のみ" Foreground="#0066CC" FontWeight="SemiBold" FontSize="12"/></Border>
                    </Grid>
                    <TextBlock Text="{Binding ResourceSummary}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    <TextBlock Text="{Binding ExternalOllamaNote}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Separator Margin="0,22,0,20" Background="#13000000"/>

                    <StackPanel Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ダウンロードする内容" FontWeight="SemiBold" FontSize="14"/>
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F5F5F8" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <TextBlock Grid.ColumnSpan="2" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="1" Text="版" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Version}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2" Text="取得元" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Source}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="3" Text="サイズ" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Size}"/>
                                            <TextBlock Grid.Row="4" Text="保存先" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Destination}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="5" Text="ライセンス" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding License}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="6" Text="SHA-256" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Sha256}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding TotalSize}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                    </StackPanel>

                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Height="7" Margin="0,22,0,0"/>
                    <TextBlock Text="{Binding ProgressDetail}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Content="ダウンロードして準備" Command="{Binding SetupCommand}" Style="{StaticResource PrimaryButton}" MinWidth="184"/>
                        <Button Content="中止" Command="{Binding CancelCommand}" Margin="12,0,0,0" Padding="20,10" MinWidth="76" Background="Transparent" BorderBrush="#20000000"/>
                        <Button Content="再確認" Command="{Binding RecheckCommand}" Margin="12,0,0,0" Padding="20,10" MinWidth="76" Background="Transparent" BorderBrush="#20000000"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="メモリの状況" Style="{StaticResource SectionTitle}" Margin="0,38,0,16"/>
            <Border Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <TextBlock Text="{Binding UsageSummary}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding PressureSummary}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Separator Margin="0,16,0,14" Background="#13000000"/>
                    <TextBlock Text="{Binding ModeLabel}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="共存モード（標準）" Command="{Binding UseCoexistenceModeCommand}" Padding="18,8" Background="Transparent" BorderBrush="#20000000"/>
                        <Button Content="集中モードを選ぶ" Command="{Binding UseFocusModeCommand}" Margin="12,0,0,0" Padding="18,8" Background="Transparent" BorderBrush="#20000000"/>
                        <Button Content="エキスパートモード…" Command="{Binding UseExpertModeCommand}" Margin="12,0,0,0" Padding="18,8" Background="Transparent" BorderBrush="#20000000"/>
                    </StackPanel>
                    <TextBlock Text="LocalStudioが他のアプリを終了したり、ブラウザのタブを閉じたりすることはありません。" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="管理者権限を使わない設計" Style="{StaticResource SectionTitle}" Margin="0,38,0,16"/>
            <Border Background="#ECECF1" CornerRadius="16" Padding="24">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0"><TextBlock Text="権限昇格なし" FontWeight="SemiBold"/><TextBlock Text="UACや管理者パスワードを要求しません。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="9,0"><TextBlock Text="端末設定を維持" FontWeight="SemiBold"/><TextBlock Text="サービス、PATH、端末全体の設定を変更しません。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="18,0,0,0"><TextBlock Text="拒否時は停止" FontWeight="SemiBold"/><TextBlock Text="社内ポリシーを回避せず、理由を表示します。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                </Grid>
            </Border>
            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="4,16,0,0" TextTrimming="CharacterEllipsis"><Run Text="保存先: "/><Run Text="{Binding StoragePath, Mode=OneWay}"/></TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
