<UserControl x:Class="SafeLocalHarness.App.Views.ChatView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Name="Root" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Background="{StaticResource CanvasBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <!-- Messages are read-only text boxes without a frame, so any part can be selected and copied (hands-on 2026-10-13). -->
        <Style x:Key="MessageText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="SelectionBrush" Value="#C9A27E"/>
            <Setter Property="FontFamily" Value="Yu Gothic UI, Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="AutomationProperties.Name" Value="メッセージ"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- Empty state: the icon and the question, centred (approved mockup). -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
            <Image Source="pack://application:,,,/Assets/LocalStudio.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="LocalStudio"/>
            <TextBlock Text="さて、何をしましょう？" Style="{StaticResource TitleText}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
        </StackPanel>

        <ScrollViewer x:Name="MessageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,24,0,8">
            <ItemsControl ItemsSource="{Binding Messages}" MaxWidth="780" Margin="40,0" AutomationProperties.Name="会話">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <!-- User: bubble on the right. -->
                            <Border Background="{StaticResource UserBubbleBrush}" CornerRadius="16" Padding="16,11" HorizontalAlignment="Right" MaxWidth="560"
                                    Visibility="{Binding IsUser, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding ImagePaths}" Visibility="{Binding HasImages, Converter={StaticResource Visible}}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Border CornerRadius="8" Margin="0,0,6,8" ClipToBounds="True"><Image Source="{Binding}" MaxHeight="140" MaxWidth="240" Stretch="Uniform"/></Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource MessageText}"/>
                                </StackPanel>
                            </Border>
                            <!-- Local Studio: plain text on the left, with choices under it. -->
                            <StackPanel Visibility="{Binding IsStudio, Converter={StaticResource Visible}}" HorizontalAlignment="Left" MaxWidth="680">
                                <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource MessageText}"/>
                                <ItemsControl ItemsSource="{Binding Choices}" Margin="0,10,0,0" Visibility="{Binding HasChoices, Converter={StaticResource Visible}}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Content="{Binding Label}" Margin="0,0,8,8" CommandParameter="{Binding Id}"
                                                Command="{Binding DataContext.ChooseCommand, ElementName=Root}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ChoiceButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource HeadingBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Text="{Binding ActivityLine}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,8"
                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="780" AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding HasActivity, Converter={StaticResource Visible}}"/>

        <!-- Input: attachments, text, attach and send. -->
        <Border Grid.Row="2" Background="{StaticResource ChatSurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="18"
                Margin="40,0,40,26" MaxWidth="780" Padding="14,10">
            <StackPanel>
                <!-- 4-2: the Word / Excel file the messages are about. -->
                <Border Background="{StaticResource SelectedProjectBrush}" CornerRadius="10" Padding="10,5" Margin="0,0,0,8" HorizontalAlignment="Left"
                        Visibility="{Binding HasDocument, Converter={StaticResource Visible}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding DocumentName}" FontSize="13" Foreground="{StaticResource HeadingBrush}" ToolTip="{Binding Document}"/>
                        <TextBlock Text="について話します（変更は新しいファイルに）" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Margin="4,0,0,0"/>
                        <Button Content="✕" Padding="6,0" Margin="6,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="ファイルの指定をやめる"
                                AutomationProperties.Name="ファイルの指定をやめる" Command="{Binding ClearDocumentCommand}"/>
                    </StackPanel>
                </Border>
                <!-- 4-1: the folder that file tasks apply to. -->
                <Border Background="{StaticResource SelectedProjectBrush}" CornerRadius="10" Padding="10,5" Margin="0,0,0,8" HorizontalAlignment="Left"
                        Visibility="{Binding HasWorkFolder, Converter={StaticResource Visible}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding WorkFolderName}" FontSize="13" Foreground="{StaticResource HeadingBrush}" ToolTip="{Binding WorkFolder}"/>
                        <TextBlock Text="のファイルを操作します" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Margin="4,0,0,0"/>
                        <Button Content="✕" Padding="6,0" Margin="6,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="フォルダーの指定をやめる"
                                AutomationProperties.Name="フォルダーの指定をやめる" Command="{Binding ClearFolderCommand}"/>
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding PendingAttachments}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="{StaticResource UserBubbleBrush}" CornerRadius="10" Padding="6" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding FullPath}" Height="44" MaxWidth="80" Stretch="Uniform"/>
                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" Margin="8,0" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                                <Button Content="✕" Padding="6,0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="添付をやめる"
                                        AutomationProperties.Name="添付をやめる" CommandParameter="{Binding}" Command="{Binding DataContext.RemoveAttachmentCommand, ElementName=Root}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="📎" FontSize="18" Padding="8,4" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                ToolTip="画像を添付（PNG/JPEG、5 MBまで・4枚まで）" AutomationProperties.Name="画像を添付" Click="OnAttachClick"/>
                        <Button Content="📁" FontSize="18" Padding="8,4" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                ToolTip="フォルダーを選んで、中のファイル名をまとめて変える" AutomationProperties.Name="フォルダーを選ぶ" Click="OnFolderClick"/>
                        <Button Content="📄" FontSize="18" Padding="8,4" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                ToolTip="Word・Excel・PDF のファイルを選んで、内容を聞いたり直したりする（PDFは複数選ぶと結合できます）" AutomationProperties.Name="Word・Excel・PDFを選ぶ" Click="OnDocumentClick"/>
                        <!-- The memory mode, switchable here at any time (user, 2026-10-19); Expert asks for confirmation first. -->
                        <Button x:Name="ModeButton" Content="{Binding ModeLabel}" ToolTip="{Binding ModeToolTip}" FontSize="12" Padding="10,3" Margin="4,0,0,6"
                                VerticalAlignment="Bottom" Cursor="Hand" BorderThickness="1" Click="OnModeClick" AutomationProperties.Name="メモリの使い方を切り替える">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpert}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource HeadingBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource HeadingBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="共存モード（標準）：他のアプリの分を多めに残す" Command="{Binding SetModeCommand}" CommandParameter="Coexistence"/>
                                    <MenuItem Header="集中モード：AIに使えるメモリを広げる" Command="{Binding SetModeCommand}" CommandParameter="Focus"/>
                                    <MenuItem Header="エキスパートモード：空いているメモリをほぼすべて使う（今回の起動中のみ）" Command="{Binding SetModeCommand}" CommandParameter="Expert"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="6,0">
                        <TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="40" MaxHeight="180" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                                 FontSize="15" Padding="4,9" VerticalContentAlignment="Center" PreviewKeyDown="OnInputKeyDown"
                                 AutomationProperties.Name="メッセージ">
                            <TextBox.CommandBindings>
                                <CommandBinding Command="ApplicationCommands.Paste" Executed="OnPaste" CanExecute="OnCanPaste"/>
                            </TextBox.CommandBindings>
                        </TextBox>
                        <TextBlock Text="{Binding InputHint}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" Margin="8,9" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="2" Content="送信" Style="{StaticResource PrimaryButton}" Command="{Binding SendCommand}" VerticalAlignment="Bottom"
                            Padding="18,8" MinHeight="36" ToolTip="送信（Enter）。改行は Shift+Enter"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
