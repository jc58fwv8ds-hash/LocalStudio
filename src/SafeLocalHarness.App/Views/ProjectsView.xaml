<UserControl x:Class="SafeLocalHarness.App.Views.ProjectsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="54,48,54,48">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="プロジェクト" Style="{StaticResource TitleText}"/>
                <TextBlock Text="このPCに安全に保存された制作物を確認できます。" FontSize="17" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="カートリッジを読み込む" Command="{Binding ImportCartridgeCommand}" Padding="18,10" Margin="0,0,10,0" ToolTip="1つの .lscart ファイルからソース一式を安全に読み込み、新しいプロジェクトとして追加します"/>
                <Button Content="再読み込み" Command="{Binding RefreshCommand}" Padding="18,10"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="{StaticResource SecondaryTextBrush}" Margin="2,22,0,14" AutomationProperties.LiveSetting="Polite"/>
        <ListBox Grid.Row="2" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="22">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,7,20,0" MaxHeight="44"/>
                                <TextBlock Text="{Binding Path}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,10,20,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Kind}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy/MM/dd HH:mm}}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding LifecycleLabel}" Foreground="#0071E3" FontSize="11" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="20" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="操作確認" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding VerificationSummary}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,16,10" AutomationProperties.LiveSetting="Polite"/>
                    <ListBox ItemsSource="{Binding VerificationFeatures}" SelectedItem="{Binding SelectedFeature}" Background="Transparent" BorderThickness="0" MaxHeight="132" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="確認する機能">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="SelectionChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionChrome" Property="Background" Value="#F5F8FC"/></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionChrome" Property="Background" Value="#EAF3FF"/><Setter TargetName="SelectionChrome" Property="BorderBrush" Value="#660071E3"/></Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectionChrome" Property="BorderBrush" Value="#0071E3"/><Setter TargetName="SelectionChrome" Property="BorderThickness" Value="2"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="#EEF5FF" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding StatusLabel}" Foreground="#0066CC" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Instruction}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Width="176">
                    <Button Content="{Binding LaunchActionLabel}" Command="{Binding OpenAppCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/>
                    <Button Content="このアプリを改善" Command="{Binding ImproveProjectCommand}" Padding="14,9" Margin="0,0,0,8" ToolTip="元のアプリを残して新しい改善版を作ります"/>
                    <Button Content="カートリッジとして書き出す" Command="{Binding ExportCartridgeCommand}" Padding="14,9" Margin="0,0,0,8" ToolTip="ソース一式とキー情報を1つの .lscart ファイルにまとめます（EXEは含めません）"/>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding VerificationApplicable}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="{Binding ConfirmFeatureLabel}" Command="{Binding ConfirmFeatureCommand}" Padding="14,9" Margin="0,0,0,8" ToolTip="選択中の機能を動作確認済みとして記録します"/>
                        <Button Content="{Binding ReportFeatureLabel}" Command="{Binding ReportFeatureCommand}" Padding="14,9" ToolTip="選択中の機能に問題があることを記録します"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="ファイルを確認するときだけ保存フォルダーを開けます。" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="保存フォルダーを開く" Command="{Binding OpenProjectCommand}" Padding="18,10"/>
        </Grid>
    </Grid>
</UserControl>
