<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The PDF helper given to generated Windows apps, run here on real PDFs (pdflite-trial). -->
    <Compile Include="..\SafeLocalHarness.Core\Toolbox\PdfLite.cs.txt" Link="Toolbox\PdfLite.cs" />
    <!-- The Excel helper, run here on real workbooks (xlsx-combine). -->
    <Compile Include="..\SafeLocalHarness.Core\Toolbox\XlsxLite.cs.txt" Link="Toolbox\XlsxLite.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SafeLocalHarness.Core\SafeLocalHarness.Core.csproj" />
    <ProjectReference Include="..\SafeLocalHarness.Windows\SafeLocalHarness.Windows.csproj" />
  </ItemGroup>
</Project>
