<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\SafeLocalHarness.Core\SafeLocalHarness.Core.csproj" />
    <ProjectReference Include="..\..\src\SafeLocalHarness.Windows\SafeLocalHarness.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded model exchanges replayed without a model (one fixture per mistake seen in real use). -->
    <EmbeddedResource Include="replay\*.jsonl" LogicalName="replay/%(Filename)%(Extension)" />
    <!-- The Excel helper given to generated Windows apps, compiled here too so it is checked against real workbooks. -->
    <Compile Include="..\..\src\SafeLocalHarness.Core\Toolbox\XlsxLite.cs.txt" Link="Toolbox\XlsxLite.cs" />
    <!-- The PDF helper likewise, checked here against PDFs made in the test and read back with PdfPig. -->
    <Compile Include="..\..\src\SafeLocalHarness.Core\Toolbox\PdfLite.cs.txt" Link="Toolbox\PdfLite.cs" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
